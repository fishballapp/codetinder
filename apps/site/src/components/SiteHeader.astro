---
import { Wordmark } from '@codetinder/ui/react';
import { HeartIcon } from '@phosphor-icons/react';
---

<header
  class="mx-auto flex max-w-[96rem] items-center justify-between gap-4 px-[clamp(1rem,3vw,3rem)] py-5"
>
  <a href="/" class="text-[clamp(1.5rem,1.2rem_+_1.2vw,2.6rem)]" aria-label="CodeTinder home">
    <Wordmark />
  </a>
  <nav class="flex items-center gap-[clamp(1rem,2.5vw,2.25rem)]">
    <a href="/#how-it-works" class="text-[1.15rem] font-semibold text-wine hover:underline max-sm:hidden">
      How it works
    </a>
    <a
      href="/#join"
      class="inline-flex items-center gap-[0.6rem] whitespace-nowrap rounded-[0.9rem] bg-lipstick px-6 py-[0.8rem] text-[1.1rem] font-semibold text-white shadow-button transition-[background-color] duration-[160ms] ease-out hover:bg-lipstick-hover max-sm:px-[0.9rem] max-sm:py-[0.6rem] max-sm:text-[0.95rem]"
    >
      <HeartIcon weight="fill" aria-hidden="true" className="size-5 text-[#ffd9e2] max-[24rem]:hidden" />
      <span>Join the waitlist</span>
    </a>
  </nav>
</header>
