# codetinder's Worker — environment schema (varlock + baymutt).
#
# Safe to commit: it names the baymutt environment the values are in, never the values. Read by the
# deploy (scripts/deploy-worker.ts, which also applies the migrations); local `wrangler dev` needs
# none of it. Locally the key is the file `BAYMUTT_KEY_FILE` names, from `baymutt ask access --read`;
# in CI it is BAYMUTT_KEY.
#
# @defaultRequired=true
# @defaultSensitive=true
# @plugin(@baymutt/varlock-plugin)
# @initBaymutt(key=$BAYMUTT_KEY)
# @setValuesBulk(baymuttLoad("fishball-ltd/codetinder/worker-web/production"))
# ---

# The service account key of the CI job (a service account that reads this one environment). Unset where `BAYMUTT_KEY_FILE` names a key file from `baymutt ask access`.
# @required=false
BAYMUTT_KEY=

# Cloudflare deploy token (Workers Scripts, D1 and Account Settings: Read; routes and certificates
# on the codetinder.dev zone). The Worker has no runtime secrets: nothing else is loaded.
CLOUDFLARE_DEPLOY_TOKEN=
