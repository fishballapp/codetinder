# Every page and file of the site. scripts/assemble-assets.ts copies this into dist/. No
# script-src: the site's React island and Astro's own inline bootstrap run from the page itself.
/*
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'none'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Named by their content (Astro's build), so they can be cached for a year. HTML is not, and keeps
# the default, so a deploy shows at once.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
