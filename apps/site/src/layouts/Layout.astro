---
// Every page's head, from the shared marketing shell: the one without analytics, as the site has
// none and sets no cookies (the privacy page says so).
import PageShell from '@internal/marketing/PageShell.astro';
import '../styles/global.css';

type Props = {
  readonly title: string;
  readonly description: string;
  readonly structuredData?: Record<string, unknown>;
};

const { title, description, structuredData } = Astro.props;
---

<PageShell
  title={title}
  description={description}
  ogSiteName="CodeTinder"
  ogImage={{
    path: '/og-image.jpg',
    alt: 'CodeTinder: swipe for the love of code',
    width: 1200,
    height: 630,
  }}
  themeColor="#fdcbe0"
  htmlLang="en"
  fontHref={null}
  icons={[{ rel: 'icon', type: 'image/svg+xml', href: '/favicon.svg' }]}
  structuredData={structuredData}
>
  <link slot="head" rel="sitemap" href="/sitemap-index.xml" />
  <slot />
</PageShell>
